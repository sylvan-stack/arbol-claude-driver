{
  "component": "arbol-claude-driver",
  "build": [
    "uv sync --locked",
    "uv run --no-sync ruff check .",
    "uv run --no-sync mypy",
    "uv run --no-sync python scripts/package_build.py"
  ],
  "entry": "bin/arbol-claude-driver",
  "checks": [
    {
      "name": "build.unit",
      "kind": "unit",
      "command": "\"$ARBOL_BUILD_DIR/runtime/python/bin/python3.14\" -I \"$ARBOL_BUILD_DIR/scripts/check_build.py\" unit"
    },
    {
      "name": "build.contract",
      "kind": "contract",
      "command": "\"$ARBOL_BUILD_DIR/runtime/python/bin/python3.14\" -I \"$ARBOL_BUILD_DIR/scripts/check_build.py\" contract"
    },
    {
      "name": "dev.build-check",
      "kind": "live",
      "command": "\"$ARBOL_BUILD_DIR/runtime/python/bin/python3.14\" -I \"$ARBOL_BUILD_DIR/scripts/check_build.py\" live"
    }
  ],
  "contract": 1,
  "dataFormat": 1
}
